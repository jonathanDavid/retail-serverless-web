# Base URL of the retail-serverless-api (API Gateway stage), including /v1.
# Example: https://abc123.execute-api.us-east-1.amazonaws.com/v1
#
# Leave this UNSET to run the dashboard in DEMO mode: the async pipeline is
# simulated client-side (orders advance through states on timers), so the site
# is fully demoable without any AWS backend deployed.
VITE_API_URL=

# Optional: base URL of genetic-visualizer-api (the GA pickup optimizer),
# e.g. http://localhost:8000. When set, completed demo orders offer an
# "Optimizar recogida" action comparing the un-optimized vs GA-optimized
# pickup (distance, travel time, store visits, cost). When unset, the
# feature is hidden. Neither project depends on the other.
VITE_OPTIMIZER_URL=
